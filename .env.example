# PostgreSQL
POSTGRES_USER=ai_interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_interview
DATABASE_URL=postgresql://ai_interview:change-me@postgres:5432/ai_interview

# LLM（默认 DeepSeek）
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
SMART_MODEL=deepseek-chat
FAST_MODEL=deepseek-chat

# 前端访问后端 API 的地址：本地 http://localhost:8000，部署后改成 http://你的服务器IP
NEXT_PUBLIC_API_URL=http://localhost:8000

# 令牌签名密钥，生产环境务必修改
JWT_SECRET=change-me
# 语音识别 (Qwen3-ASR-Flash，阿里云百炼)
ASR_API_KEY=sk-your-dashscope-key
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# 语音合成 / 语音对话 (Qwen3-Omni)
VOICE_API_KEY=sk-your-dashscope-key
VOICE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VOICE_MODEL=qwen3-omni-flash-2025-12-01
